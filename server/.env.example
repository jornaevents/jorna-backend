# Copy this file to .env and fill in every value before starting the server.
# Never commit .env — it is listed in .gitignore.

# ── JWT Secret ────────────────────────────────────────────────────────
# Used to sign all JWT tokens. Must be a long random string.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Database ──────────────────────────────────────────────────────────
# Leave blank for local SQLite (auto-created as desiconnect.db).
# For production set this to your PostgreSQL/Supabase connection string:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of origins the browser frontend is served from.
# In production replace these with your real domain(s).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Supabase ─────────────────────────────────────────────────────────
# How to get these:
#   1. Go to https://supabase.com/dashboard → your project → Settings → API
#   2. Copy "Project URL" → SUPABASE_URL
#   3. Copy "service_role" key (under "Project API keys") → SUPABASE_SERVICE_KEY
#      WARNING: the service_role key bypasses Row Level Security — never expose it to the client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
#
# Required Storage buckets (create in Supabase dashboard → Storage → New bucket, set to Public):
#   - avatars          (user profile pictures)
#   - service-images   (vendor service photos, max 10 per service, 5 MB each)

# ── Google Calendar OAuth ─────────────────────────────────────────────
# Path to your OAuth 2.0 client secret JSON file (downloaded from Google Cloud Console).
# How to get it:
#   1. Go to https://console.cloud.google.com → APIs & Services → Credentials
#   2. Open (or create) an OAuth 2.0 Client ID → Download JSON
#   3. Save the file as server/client_secret.json
# Never commit the actual file — only reference its path here.
GOOGLE_CLIENT_SECRET_PATH=client_secret.json

# Where Google redirects after the vendor grants calendar access.
# Must exactly match an "Authorised redirect URI" registered in Google Cloud Console.
# For local dev: http://localhost:8000/vendors/auth/callback
# For production: https://your-api-domain.com/vendors/auth/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/vendors/auth/callback

# ── Firebase Cloud Messaging ──────────────────────────────────────────
# Path to your Firebase service account credentials JSON file.
# How to get it:
#   1. Go to https://console.firebase.google.com → Project Settings → Service Accounts
#   2. Click "Generate new private key" → download the JSON
#   3. Save the file as server/firebase_credentials.json
# Never commit the actual file — only reference its path here.
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# ── YouTube ───────────────────────────────────────────────────────────
# Used for the short-form video feed (GET /feed/shorts).
# How to get it:
#   1. Go to https://console.cloud.google.com → APIs & Services → Credentials
#   2. Create an API key and restrict it to the YouTube Data API v3
YOUTUBE_API_KEY=

# ── Stripe ────────────────────────────────────────────────────────────
# How to get these:
#   1. Go to https://dashboard.stripe.com/apikeys
#   2. Copy the "Secret key" (sk_test_... for test mode) → STRIPE_SECRET_KEY
#   3. Copy the "Publishable key" (pk_test_...) → STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook signing secret — used to verify that webhook events come from Stripe.
# For local development:
#   1. Install the Stripe CLI: https://stripe.com/docs/stripe-cli
#   2. Run: stripe listen --forward-to localhost:8000/payments/webhook
#   3. Copy the "whsec_..." secret it prints → paste below
# For production:
#   1. Go to https://dashboard.stripe.com → Developers → Webhooks
#   2. Add an endpoint pointing to https://your-api-domain.com/payments/webhook
#   3. Copy the "Signing secret" from that webhook → paste below
STRIPE_WEBHOOK_SECRET=whsec_...

# Platform fee taken on each booking (integer percent, e.g. 5 = 5%).
PLATFORM_FEE_PERCENT=5

# ── Email (Resend) ────────────────────────────────────────────────────
# Transactional email — fallback for booking notifications when a user has no
# push token, and for password-reset emails. Leave blank to disable email.
#   1. Sign up at https://resend.com and verify your sending domain
#   2. Create an API key → paste below
#   3. Set EMAIL_FROM to an address on your verified domain
RESEND_API_KEY=re_...
EMAIL_FROM=Desiconnect <noreply@desiconnect.com>
