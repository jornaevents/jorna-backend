# ── Required ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Database ──────────────────────────────────────────────────────────
# Local dev defaults to SQLite if this is unset.
# For production use your Supabase / PostgreSQL connection string:
#   postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Defaults to http://localhost:3000,http://localhost:8080 if unset.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Google Calendar OAuth ─────────────────────────────────────────────
# Path to your Google OAuth client secret JSON file.
# Never commit the actual file — only reference its path here.
GOOGLE_CLIENT_SECRET_PATH=client_secret.json

# ── Firebase ──────────────────────────────────────────────────────────
# Path to your Firebase service account credentials JSON file.
# Never commit the actual file — only reference its path here.
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# ── Stripe ────────────────────────────────────────────────────────────
# Keys from https://dashboard.stripe.com/apikeys (use test keys for dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --forward-to ...` output during local development,
# or from Dashboard → Developers → Webhooks in production.
STRIPE_WEBHOOK_SECRET=whsec_...
# Platform fee charged on each booking (integer percent, e.g. 5 = 5%).
PLATFORM_FEE_PERCENT=5
